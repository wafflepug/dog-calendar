# Configuration reference; this file is not automatically loaded.
# npm run dev starts a loopback-only demo Auth emulator and local PostgreSQL.
PLATFORM_MODE=local
PORT=4380
DATA_DIR=.local/pg
FIREBASE_PROJECT_ID=demo-palz-stay
FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9199
# Future cloud deployment requires separate verified credentials/infrastructure.
# PLATFORM_MODE=production
# PLATFORM_ORIGIN=https://YOUR-APP-HOST
# FIREBASE_PROJECT_ID=YOUR-ISOLATED-PROJECT
# FIREBASE_WEB_API_KEY=PUBLIC-WEB-CONFIG-ONLY
# FIREBASE_AUTH_DOMAIN=YOUR-ISOLATED-PROJECT.firebaseapp.com
# FIREBASE_APP_ID=PUBLIC-WEB-APP-ID
# DATABASE_URL=postgresql://RESTRICTED-APP-ROLE@PRIVATE-DATABASE/palz
# GOOGLE_APPLICATION_CREDENTIALS=/private/path/credential.json
