<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root" android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:padding="16dp" android:background="@drawable/widget_bg">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal">
        <TextView android:id="@+id/title" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="TODAY" android:textColor="#315B49" android:textSize="12sp" android:textStyle="bold" android:letterSpacing="0.1" />
        <TextView android:id="@+id/refresh" android:layout_width="44dp" android:layout_height="44dp" android:gravity="center" android:text="↻" android:contentDescription="Refresh Today" android:textColor="#315B49" android:textSize="24sp" />
    </LinearLayout>
    <TextView android:id="@+id/status" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:text="Set up to see today’s schedule" android:textColor="#494A45" android:textSize="14sp" />
    <LinearLayout android:id="@+id/counts" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:orientation="horizontal" android:visibility="gone">
        <TextView android:id="@+id/staying" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:textColor="#202923" android:textSize="14sp" android:textStyle="bold" />
        <TextView android:id="@+id/arriving" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:textColor="#202923" android:textSize="14sp" android:textStyle="bold" />
        <TextView android:id="@+id/leaving" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:textColor="#202923" android:textSize="14sp" android:textStyle="bold" />
    </LinearLayout>
    <TextView android:id="@+id/handover" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="7dp" android:textColor="#494A45" android:textSize="12sp" android:visibility="gone" />
    <TextView android:id="@+id/updated" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="5dp" android:textColor="#77766F" android:textSize="11sp" android:visibility="gone" />
</LinearLayout>
